#!/bin/sh
# ⛔ CCODE-288 — RUN THE SUITE BEFORE IT LEAVES THE MACHINE.
# CI catches a bad push in a minute; this catches it in seconds, and with two agents pushing to one branch
# the difference is a rebase nobody has to do. Skip deliberately with `git push --no-verify`.
echo "pre-push: running the suite (skip with --no-verify)"
node scripts/run_tests.mjs --quiet
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "  ⛔ SUITE RED — push blocked."
  echo "     Fix it, or push with --no-verify if you know why it is red and are pushing anyway."
  exit 1
fi
exit 0
